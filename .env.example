# 로컬 개발 설정. 실제 키는 아래 빈칸에 입력하세요.
# .env.local이 있으면 Next.js에서 해당 값이 우선 적용됩니다.

# 앱: mock에서는 AI와 결제가 모의로 동작하고 Supabase는 실제로 사용합니다.
APP_MODE=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: 클라우드 dev 프로젝트에 연결합니다(로컬 Docker는 쓰지 않습니다).
# 키는 대시보드의 Project Settings → API Keys에서 확인하세요.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic: APP_MODE=live에서 필요합니다.
ANTHROPIC_API_KEY=

# Polar: 로컬 live 검증은 sandbox 상품과 키를 사용합니다.
POLAR_ENV=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=

# 내부 maintenance 핸들러 인증용 비밀값을 설정하세요.
CRON_SECRET=
