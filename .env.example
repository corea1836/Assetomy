# 로컬 개발 설정. 실제 키는 아래 빈칸에 입력하세요.
# .env.local이 있으면 Next.js에서 해당 값이 우선 적용됩니다.

# 앱: mock에서는 AI와 결제가 모의로 동작하고 Supabase는 실제로 사용합니다.
APP_MODE=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: 로컬 Docker 기본 주소. dev 프로젝트 사용 시 URL을 변경하세요.
# 키는 Supabase CLI 또는 dev 프로젝트의 API 설정에서 확인하세요.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic: APP_MODE=live에서 필요합니다.
ANTHROPIC_API_KEY=

# Polar: 로컬 live 검증은 sandbox 상품과 키를 사용합니다.
POLAR_ENV=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=

# 내부 maintenance 핸들러 인증용 비밀값을 설정하세요.
CRON_SECRET=
